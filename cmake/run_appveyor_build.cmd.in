@echo off
rem Generated by CMake from cmake/run_appveyor_build.cmd.in
rem Reproduces the build_script section of appveyor.yml using the
rem GCC ARM toolchain and MSBuild located by CMakeLists.txt.

setlocal

set CLRROOT=@TOPPERS_CLRROOT@
set GNU_TOOLS_BIN=@GNU_TOOLS_BIN@
set GNU_TARGET=@TOPPERS_GCC_PREFIX@
set MSBUILD_EXE=@TOPPERS_MSBUILD@
set PATH=%GNU_TOOLS_BIN%;%PATH%

echo === Building Solutions\ToppersHRP2onEV3\dotnetmf.proj ===
pushd "%CLRROOT%\Solutions\ToppersHRP2onEV3"
"%MSBUILD_EXE%" dotnetmf.proj /t:rebuild /p:flavor=@TOPPERS_FLAVOR@;memory=flash
if errorlevel 1 (
    popd
    echo Build failed: Solutions\ToppersHRP2onEV3\dotnetmf.proj
    exit /b 1
)
popd

echo === Building DeviceCode\Targets\OS\Toppers\hrp2\workspace\helloev3onnetmf\dotnetmf.proj ===
pushd "%CLRROOT%\DeviceCode\Targets\OS\Toppers\hrp2\workspace\helloev3onnetmf"
"%MSBUILD_EXE%" dotnetmf.proj /t:rebuild /p:flavor=@TOPPERS_FLAVOR@;memory=flash
if errorlevel 1 (
    popd
    echo Build failed: DeviceCode\Targets\OS\Toppers\hrp2\workspace\helloev3onnetmf\dotnetmf.proj
    exit /b 1
)
popd

endlocal
